// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Claim {
  id                Int       @id // claimId from contract
  policyId          String    // holderAddress:policyId
  creatorAddress    String
  amount            String
  asset             String?
  description       String?
  imageUrls         String[]  @default([])
  status            ClaimStatus   @default(PENDING)
  severity          ClaimSeverity?
  isFinalized       Boolean   @default(false)
  approveVotes      Int       @default(0)
  rejectVotes       Int       @default(0)
  paidAt            DateTime?
  createdAtLedger   Int
  updatedAtLedger   Int       @default(0)
  txHash            String?
  eventIndex        Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  /// Logical tenant identifier. NULL in single-tenant deployments.
  /// Populated by the indexer from the contract's tenant context.
  tenantId          String?
  /// Set when the row is logically removed (admin/compliance). Null = active.
  deletedAt         DateTime? @map("deleted_at")

  // ── Appeal fields ────────────────────────────────────────────────────────
  /// Number of appeals opened for this claim. Used for idempotency checks.
  appealsCount      Int       @default(0) @map("appeals_count")
  /// The tx hash of the most recent appeal submission. Used to detect duplicate submissions.
  appealTxHash      String?   @map("appeal_tx_hash")

  // Relations
  policy            Policy    @relation(fields: [policyId], references: [id])
  votes             Vote[]
  comments          ClaimComment[]
  evidenceMetadata  EvidenceMetadata?

  @@index([status])
  @@index([severity])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([policyId])
  @@index([policyId, deletedAt, createdAt])
  @@index([createdAt, id]) // keyset pagination: ORDER BY createdAt DESC, id DESC
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt, id]) // tenant-scoped keyset pagination
  @@map("claims")
}

model Vote {
  id            Int       @id @default(autoincrement())
  claimId       Int
  voterAddress  String
  vote          VoteType
  votingPower   Int       @default(1)
  txHash        String?
  eventIndex    Int?
  votedAtLedger Int
  createdAt     DateTime  @default(now())
  deletedAt     DateTime? @map("deleted_at")

  // Relations
  claim         Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@unique([claimId, voterAddress])
  @@index([voterAddress])
  @@index([claimId])
  @@index([claimId, deletedAt])
  @@index([deletedAt])
  @@map("votes")
}

model Policy {
  id                    String   @id // holderAddress:policyId
  policyId              Int
  holderAddress         String
  policyType            String
  region                String
  coverageAmount        String
  premium               String
  isActive              Boolean  @default(true)
  startLedger           Int
  endLedger             Int
  /// SEP-41 asset contract ID bound to this policy for premium and payout.
  /// Null for legacy policies created before multi-asset support.
  assetContractId       String?
  txHash                String?
  eventIndex            Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  /// Logical tenant identifier. NULL in single-tenant deployments.
  tenantId              String?
  deletedAt             DateTime? @map("deleted_at")

  // Relations
  claims                Claim[]

  @@unique([holderAddress, policyId])
  @@index([holderAddress])
  @@index([isActive])
  @@index([createdAt, id]) // keyset pagination: ORDER BY createdAt DESC, id DESC
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, createdAt, id]) // tenant-scoped keyset pagination
  @@index([deletedAt])
  @@map("policies")
}

model IndexerState {
  id              Int      @id @default(autoincrement())
  lastLedger      Int
  lastCursor      String?
  updatedAt       DateTime @updatedAt

  @@map("indexer_state")
}

/// Per-Stellar-network indexer progress. `last_processed_ledger` is the last ledger
/// sequence whose relevant contract events have been applied (cursor advances in the
/// same DB transaction as raw event / projection upserts).
model LedgerCursor {
  network               String   @id
  lastProcessedLedger   Int      @map("last_processed_ledger")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("ledger_cursors")
}

/// One row per network: last time a ledger gap alert was emitted (dedup / cooldown).
model LedgerGapAlertDedup {
  network               String   @id
  lastFiredAt           DateTime @map("last_fired_at")
  lastGapSize           Int?     @map("last_gap_size")
  lastProcessedLedger   Int?     @map("last_processed_ledger")
  latestLedger          Int?     @map("latest_ledger")

  @@map("ledger_gap_alert_dedup")
}

model NotificationPreference {
  userId                  String   @id
  renewalRemindersEnabled Boolean? @map("renewal_reminders_enabled")
  claimUpdatesEnabled     Boolean? @map("claim_updates_enabled")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

model RawEvent {
  id              Int      @id @default(autoincrement())
  txHash          String
  eventIndex      Int
  contractId      String
  ledger          Int
  ledgerClosedAt  DateTime
  topic1          String?
  topic2          String?
  topic3          String?
  topic4          String?
  data            Json
  createdAt       DateTime @default(now())

  @@unique([txHash, eventIndex])
  @@index([contractId])
  @@index([ledger])
  @@map("raw_events")
}

enum ClaimStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  UNDER_APPEAL
  APPEAL_APPROVED
  APPEAL_REJECTED
}

enum ClaimSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum VoteType {
  APPROVE
  REJECT
}

/// Immutable operational audit trail written by admin endpoints.
/// Rows must never be updated or deleted — append-only.
model AdminAuditLog {
  id          String   @id @default(uuid())
  actor       String   /// wallet address or staff email of the operator
  action      String   /// e.g. "reindex", "pause", "feature_flag_update"
  payload     Json     /// full request payload for forensic replay
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([actor])
  @@index([action])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

/// Immutable audit trail for tenant configuration changes.
/// Tracks who changed which tenant config key and when, including old/new values for forensics.
/// Rows must never be updated or deleted — append-only.
model TenantConfigAuditLog {
  id        String   @id @default(uuid())
  tenantId  String   /// tenant identifier or 'default' for global config
  actor     String   /// wallet address or email of the user who made the change
  key       String   /// configuration key name (e.g. "solvency_buffer_threshold")
  oldValue  String?  /// previous value (JSON-serialized, null if key was newly added)
  newValue  String   /// new value (JSON-serialized)
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([key])
  @@index([actor])
  @@map("tenant_config_audit_logs")
}

/// Runtime feature flags toggled by admin operators.
model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String?
  updatedBy   String
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

/// Deduplication table for wasm drift alerts — one row per (contract, actual-hash) pair.
/// Prevents repeated webhook spam for the same unresolved drift.
model WasmDriftAlert {
  id            String   @id @default(uuid())
  dedupKey      String   @unique /// "<contractName>:<actualHash>"
  contractName  String
  contractId    String
  expectedHash  String
  actualHash    String
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([contractName])
  @@map("wasm_drift_alerts")
}

/// Tracks staff-initiated privacy requests (GDPR/CCPA-style) for off-chain data.
/// On-chain and IPFS data is immutable and cannot be erased — see runbook.
model PrivacyRequest {
  id                    String    @id @default(uuid())
  subjectWalletAddress  String
  requestType           String    /// "ANONYMIZE" | "DELETE"
  requestedBy           String    /// staff actor (wallet address or email)
  status                String    @default("IN_PROGRESS") /// "IN_PROGRESS" | "COMPLETED" | "FAILED"
  rowsAffected          Int       @default(0)
  notes                 String?
  errorMessage          String?
  completedAt           DateTime?
  createdAt             DateTime  @default(now())

  @@index([subjectWalletAddress])
  @@index([status])
  @@map("privacy_requests")
}

/// Off-chain metadata for allowlisted SEP-41 asset contracts.
/// Populated by the indexer when it observes AssetAdded events.
/// Used by the frontend and API to display correct symbol/decimals.
model AllowedAsset {
  /// SEP-41 contract address (Stellar strkey format).
  contractId    String   @id
  /// Token symbol, e.g. "USDC", "XLM". Populated off-chain.
  symbol        String?
  /// Decimal places, e.g. 7 for XLM/USDC on Stellar.
  decimals      Int      @default(7)
  /// Whether this asset is currently on the allowlist.
  isAllowed     Boolean  @default(true)
  /// Ledger at which the asset was added to the allowlist.
  addedAtLedger Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("allowed_assets")
}

/// Support ticket submitted via the /support contact form.
model SupportTicket {
  id               String       @id @default(uuid())
  email            String
  subject          String
  message          String
  /// One-way hash of submitter IP for spam detection (no raw IP stored).
  ipHash           String?
  status           TicketStatus @default(OPEN)
  /// Staff member assigned to handle this ticket (null = unassigned).
  assignedTo       String?      @map("assigned_to")
  /// Set once when the first staff status update is recorded.
  firstRespondedAt DateTime?    @map("first_responded_at")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  replies          SupportTicketReply[]

  @@index([status])
  @@index([assignedTo])
  @@index([createdAt])
  @@index([firstRespondedAt])
  @@map("support_tickets")
}

/// Customer or staff reply to a support ticket.
model SupportTicketReply {
  id        String   @id @default(uuid())
  ticketId  String   @map("ticket_id")
  message   String
  /// 'customer' or 'staff'
  author    String
  createdAt DateTime @default(now())

  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
  @@map("support_ticket_replies")
}

/// Privacy-safe FAQ expansion counters.
model FaqStat {
  faqId      String   @id
  expansions Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("faq_stats")
}

/// Admin-managed FAQ entries shown on the public support page.
model FaqItem {
  id           String   @id @default(uuid())
  question     String
  answer       String
  category     String   @default("General")
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@map("faq_items")
}

/// Tenant provisioning configuration.
model Tenant {
  id          String   @id @default(uuid())
  name        String
  contractIds String[] // JSON array stored as text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([createdAt])
  @@map("tenants")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// Persistent notification record. Frontend ACKs on render; unacknowledged records
/// past expiresAt are eligible for re-delivery by the notification job.
model Notification {
  id             String    @id @default(uuid())
  userId         String
  type           String
  payload        Json
  acknowledgedAt DateTime? @map("acknowledged_at")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([userId, acknowledgedAt])
  @@index([expiresAt, acknowledgedAt])
  @@map("notifications")
}

/// Records each policy renewal for analytics. Written by RenewalService on XDR assembly.
model PolicyRenewal {
  id                 String   @id @default(uuid())
  policyCompositeId  String   @map("policy_composite_id")
  holderAddress      String   @map("holder_address")
  policyType         String   @map("policy_type")
  region             String
  previousEndLedger  Int      @map("previous_end_ledger")
  newEndLedger       Int      @map("new_end_ledger")
  premiumPaidStroops String   @map("premium_paid_stroops")
  renewedAt          DateTime @default(now()) @map("renewed_at")

  @@index([policyCompositeId])
  @@index([policyType, region])
  @@index([renewedAt])
  @@map("policy_renewals")
}

/// Off-chain comment on a claim. Soft-deleted via deletedAt.
model ClaimComment {
  id            String    @id @default(cuid())
  claimId       Int       @map("claim_id")
  authorAddress String    @map("author_address")
  body          String
  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  claim         Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId, deletedAt, createdAt])
  @@index([authorAddress, claimId])
  @@map("claim_comments")
}

model EvidenceMetadata {
  id              Int       @id @default(autoincrement())
  claimId         Int       @map("claim_id")
  cid             String?   /// IPFS Content Identifier
  url             String?   /// Gateway URL
  fileSizeBytes   Int?      @map("file_size_bytes")
  mimeType        String?   @map("mime_type")
  createdAt       DateTime  @default(now()) @map("created_at")

  claim           Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@unique([claimId])
  @@index([claimId])
  @@map("evidence_metadata")
}

/// Tracks voters registered on-chain via admin governance actions.
model RegisteredVoter {
  walletAddress  String   @id @map("wallet_address")
  displayName    String?  @map("display_name")
  registeredBy   String   @map("registered_by")
  registeredAt   DateTime @default(now()) @map("registered_at")

  @@map("registered_voters")
}

/// Off-chain profile for a wallet holder. Created on first authenticated GET /profile.
model HolderProfile {
  walletAddress         String   @id @unique @map("wallet_address")
  displayName           String?  @map("display_name")
  /// Stored as-is; anonymized by the privacy service on request.
  email                 String?
  locale                String?  @default("en")
  notificationPreferences Json?  @default("{}") @map("notification_preferences")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  lastSeenAt            DateTime? @map("last_seen_at")

  @@index([lastSeenAt])
  @@map("holder_profiles")
}

/// Off-chain user-generated posts. Supports soft-delete via deletedAt.
model Post {
  id            Int        @id @default(autoincrement())
  title         String     @db.VarChar(200)
  body          String     @db.VarChar(10000)
  status        PostStatus @default(DRAFT)
  authorAddress String     @map("author_address")
  publishAt     DateTime?  @map("publish_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  @@index([status])
  @@index([authorAddress])
  @@index([deletedAt])
  @@index([createdAt, id]) // keyset pagination: ORDER BY createdAt DESC, id DESC
  @@index([publishAt])
  @@map("posts")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Tracks ramp transaction records received via webhooks for reconciliation.
model RampTransaction {
  id                String   @id @default(uuid())
  purchaseId        String   @unique /// Ramp provider's purchase ID
  status            String   /// COMPLETE, FAILED, REFUNDED
  receiverAddress   String   @map("receiver_address")
  cryptoAmount      String   @map("crypto_amount")
  cryptoCurrency    String   @map("crypto_currency")
  fiatValue         Decimal  @map("fiat_value")
  fiatCurrency      String   @map("fiat_currency")
  finalTxHash       String?  @map("final_tx_hash")
  lastSyncedAt      DateTime @map("last_synced_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([receiverAddress])
  @@index([lastSyncedAt])
  @@map("ramp_transactions")
}

/// Tracks last-known health status of the ramp provider.
model RampProviderHealth {
  id                String   @id @default(uuid())
  status            String   /// up, degraded, down
  lastCheckedAt     DateTime @map("last_checked_at")
  errorMessage      String?  @map("error_message")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("ramp_provider_health")
}

/// Immutable audit log for profile field-level changes.
model ProfileAuditLog {
  id                String   @id @default(uuid())
  walletAddress     String   @map("wallet_address")
  fieldName         String   @map("field_name")
  oldValue          String?  @map("old_value")
  newValue          String?  @map("new_value")
  actor             String   /// wallet address or system identifier
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([walletAddress])
  @@index([fieldName])
  @@index([createdAt])
  @@map("profile_audit_logs")
}
