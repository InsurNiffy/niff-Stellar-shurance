# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stellar_quote

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Soroban RPC ───────────────────────────────────────────────────────────────
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ── OpenTelemetry tracing ─────────────────────────────────────────────────────
# Tracing is disabled by default in development (no-op tracer).
# Set OTEL_ENABLED=true to emit spans.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=stellar-quote-backend
# OTLP endpoint for the collector / Jaeger (gRPC by default).
# Local Jaeger all-in-one accepts OTLP on 4317 (gRPC) and 4318 (HTTP).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Use "http/protobuf" to export over 4318 instead of gRPC.
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# Optional sampling ratio (1.0 = sample everything).
# OTEL_TRACES_SAMPLER_ARG=1.0

# ── Local Jaeger (development) ────────────────────────────────────────────────
# docker run --rm --name jaeger \
#   -p 16686:16686 -p 4317:4317 -p 4318:4318 \
#   jaegertracing/all-in-one:latest
# Then open http://localhost:16686 to inspect traces.
